{
  "name": "poltergeist-detector",
  "version": "0.1.0",
  "description": "Poltergeist Detector: a CLI that compares two photos of the same place and reports what appeared, vanished or moved.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "poltergeist-detector": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --import tsx src/cli.ts",
    "mcp": "node --import tsx src/mcp-server.ts"
  },
  "dependencies": {
    "@skeleton-playground/core": "workspace:*",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.22.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "tsx": "4.23.15"
  }
}
