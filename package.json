{
  "name": "@skeleton-crew/anything-you-can-do",
  "version": "0.1.0",
  "description": "Kiroween Skeleton Crew Anything You Can Do: a reusable object detection skeleton with an MCP server kit, and two apps built on it.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:models": "RUN_MODEL_TESTS=1 vitest run models.integration",
    "build": "pnpm -r --if-present build",
    "demo:poltergeist": "node --import tsx apps/poltergeist-detector/src/cli.ts compare samples/before_tomatoes.jpg samples/after_tomatoes.jpg --out demo-output/haunting-report.png"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.22.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
